# =============================================================================
# SSO IDENTITY HUB - LOCAL & CONTAINER CONFIGURATION TEMPLATE
# =============================================================================

# 1. Domain & Ports Mapping
DOMAIN_SUFFIX=sso.test
HTTP_PORT=80
HTTPS_PORT=443
KEYCLOAK_HOST_PORT=8888

# 2. PostgreSQL Database (Keycloak storage)
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432

# 3. Redis Cache & Session Storage
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here

# 4. Keycloak Identity Provider (Admin & Realm)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=sso-platform
KEYCLOAK_PUBLIC_URL=http://localhost:8888

# 5. Client Secrets (Confidential Clients: Next.js / Là Việt)
APP_B_CLIENT_ID=app-b
APP_B_CLIENT_SECRET=app-b-confidential-secret-key-123456

# 6. Connected Platforms Redirect URIs
CIC_PRODUCTION_URL=https://creative-industry-center.vercel.app
LAVIET_PRODUCTION_URL=https://la-vi-et.vercel.app
